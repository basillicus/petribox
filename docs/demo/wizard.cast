[0.000, "o", "\r\r\n\u001b[36m3. Extras\u001b[0m\r\r\n"]
[0.004, "o", "┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\r\n┃\u001b[1m \u001b[0m\u001b[1mExtra      \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mDescription                                                                       \u001b[0m\u001b[1m \u001b[0m┃\r\r\n┡━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\r\n│\u001b[36m \u001b[0m\u001b[36mclaude-code\u001b[0m\u001b[36m \u001b[0m│ Claude Code (native installer)                                                     │\r\r\n│\u001b[36m \u001b[0m\u001b[36mcodex      \u001b[0m\u001b[36m \u001b[0m│ OpenAI Codex CLI                                                                   │\r\r\n│\u001b[36m \u001b[0m\u001b[36mhermes     \u001b[0m\u001b[36m \u001b[0m│ Hermes Agent by Nous Research (setup: hermes setup)                                │\r\r\n│\u001b[36m \u001b[0m\u001b[36mmise       \u001b[0m\u001b[36m \u001b[0m│ mise, the tool and runtime version manager                                         │\r\r\n│\u001b[36m \u001b[0m\u001b[36mnode       \u001b[0m\u001b[36m \u001b[0m│ Node.js (through mise; LTS unless pinned, e.g. node@24.22.1)                       │\r\r\n│\u001b[36m \u001b[0m\u001b[36mopenclaw   \u001b[0m\u001b[36m \u001b[0m│ OpenClaw, personal assistant agent (setup: openclaw onboard)                       │\r\r\n│\u001b[36m \u001b[0m\u001b[36mopencode   \u001b[0m\u001b[36m \u001b[0m│ opencode, terminal coding agent                                                    │\r\r\n│\u001b[36m \u001b[0m\u001b[36mpi         \u001b[0m\u001b[36m \u001b[0m│ Pi coding agent, minimal and extensible                                            │\r\r\n│\u001b[36m \u001b[0m\u001b[36mpicoclaw   \u001b[0m\u001b[36m \u001b[0m│ PicoClaw, lightweight Go assistant (setup: picoclaw onboard)                       │\r\r\n│\u001b[36m \u001b[0m\u001b[36mpodman "]
[0.000, "o", "    \u001b[0m\u001b[36m \u001b[0m│ Podman (in a container it also needs: incus config set NAME security.nesting=true) │\r\r\n│\u001b[36m \u001b[0m\u001b[36mssh        \u001b[0m\u001b[36m \u001b[0m│ OpenSSH server; your host's public key is authorised for the dish user             │\r\r\n│\u001b[36m \u001b[0m\u001b[36muv         \u001b[0m\u001b[36m \u001b[0m│ uv, for Python versions, packages and tools                                        │\r\r\n└─────────────┴────────────────────────────────────────────────────────────────────────────────────┘\r\r\n\u001b[2mAlready in the recipe: node, uv, ssh\u001b[0m\r\r\n"]
