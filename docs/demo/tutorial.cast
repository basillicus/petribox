[0.144, "o", "\u001b[32m╭────────────────────────────────────────────╮\u001b[0m\r\r\n\u001b[32m│\u001b[0m \u001b[1;32mpetribox: new dish\u001b[0m                         \u001b[32m│\u001b[0m\r\r\n\u001b[32m│\u001b[0m \u001b[2mEnter keeps the default shown in brackets.\u001b[0m \u001b[32m│\u001b[0m\r\r\n\u001b[32m╰────────────────────────────────────────────╯\u001b[0m\r\r\n"]
[0.000, "o", "\r\r\n\u001b[36m1. Source\u001b[0m\r\r\n"]
[0.129, "o", "┏━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\r\n┃\u001b[1m \u001b[0m\u001b[1mChoice        \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mType           \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mBase            \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mDescription                                         \u001b[0m\u001b[1m \u001b[0m┃\r\r\n┡━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\r\n│\u001b[36m \u001b[0m\u001b[36march          \u001b[0m\u001b[36m \u001b[0m│ vm              │ \u001b[33mbuilds first    \u001b[0m │ Arch Linux VM                                        │\r\r\n│\u001b[36m \u001b[0m\u001b[36mdebian        \u001b[0m\u001b[36m \u001b[0m│ vm              │ \u001b[33mbuilds first    \u001b[0m │ Debian 13 VM                                         │\r\r\n│\u001b[36m \u001b[0m\u001b[36mkali          \u001b[0m\u001b[36m \u001b[0m│ vm              │ \u001b[33mbuilds first    \u001b[0m │ Kali Linux VM (official QEMU image)                  │\r\r\n│\u001b[36m \u001b[0m\u001b[36mkali-container\u001b[0m\u001b[36m \u001b[0m│ container       │ \u001b[33mbuilds first    \u001b[0m │ Kali Linux container (needs root entries in          │\r\r\n│\u001b[36m                \u001b[0m│                 │                  │ /etc/subuid and /etc/subgid)                         │\r\r\n│\u001b[36m \u001b[0m\u001b[36momarchy       \u001b[0m\u001b[36m \u001b[0m│ vm              │ \u001b[33mbuilds first    \u001b[0m │ Omarchy VM (official VM image)                       │\r\r\n│\u001b[36m \u001b[0m\u001b[36mrocky         \u001b[0m\u001b[36m \u001b[0m│ vm              │ \u001b[33mbuilds first    \u001b[0m │ Rocky Linux 9 VM                                     │\r\r\n│\u001b[36m \u001b[0m\u001b[36mwebshop       \u001b[0m\u001b[3"]
[0.000, "o", "6m \u001b[0m│ vm              │ \u001b[32mready           \u001b[0m │ Webshop dev VM: Debian 13 with Node, uv and SSH      │\r\r\n│\u001b[36m \u001b[0m\u001b[36mimage         \u001b[0m\u001b[36m \u001b[0m│ vm or container │ \u001b[2mset up each time\u001b[0m │ any Incus image, no recipe (you can save it as one   │\r\r\n│\u001b[36m                \u001b[0m│                 │                  │ at the end)                                          │\r\r\n└────────────────┴─────────────────┴──────────────────┴──────────────────────────────────────────────────────┘\r\r\n\u001b[2mA recipe's base is built once (minutes), then each dish is a copy (seconds).\u001b[0m\r\r\n"]
[0.000, "o", "From \u001b[1;35m[arch/debian/kali/kali-container/omarchy/rocky/webshop/image]\u001b[0m \u001b[1;36m(image)\u001b[0m: "]
[1.632, "o", "webshop\r\r\n"]
[0.000, "o", "\r\r\n\u001b[36m2. Dish\u001b[0m\r\r\n"]
[0.001, "o", "Name \u001b[1;36m(lab)\u001b[0m: "]
[1.712, "o", "shop-try\r\r\n"]
[0.000, "o", "CPUs \u001b[1;36m(2)\u001b[0m: "]
[0.851, "o", "\r\r\n"]
[0.000, "o", "Memory \u001b[1;36m(4GiB)\u001b[0m: "]
[0.851, "o", "\r\r\n"]
[0.000, "o", "Ephemeral (deleted when it stops)? \u001b[1;35m[y/n]\u001b[0m \u001b[1;36m(y)\u001b[0m: "]
[0.959, "o", "y\r\r\n"]
[0.000, "o", "\r\r\n\u001b[36m3. Extras\u001b[0m\r\r\n"]
[0.004, "o", "┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\r\n┃\u001b[1m \u001b[0m\u001b[1mExtra      \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mDescription                                                                       \u001b[0m\u001b[1m \u001b[0m┃\r\r\n┡━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\r\n│\u001b[36m \u001b[0m\u001b[36mclaude-code\u001b[0m\u001b[36m \u001b[0m│ Claude Code (native installer)                                                     │\r\r\n│\u001b[36m \u001b[0m\u001b[36mcodex      \u001b[0m\u001b[36m \u001b[0m│ OpenAI Codex CLI                                                                   │\r\r\n│\u001b[36m \u001b[0m\u001b[36mhermes     \u001b[0m\u001b[36m \u001b[0m│ Hermes Agent by Nous Research (setup: hermes setup)                                │\r\r\n│\u001b[36m \u001b[0m\u001b[36mmise       \u001b[0m\u001b[36m \u001b[0m│ mise, the tool and runtime version manager                                         │\r\r\n│\u001b[36m \u001b[0m\u001b[36mnode       \u001b[0m\u001b[36m \u001b[0m│ Node.js (through mise; LTS unless pinned, e.g. node@24.22.1)                       │\r\r\n│\u001b[36m \u001b[0m\u001b[36mopenclaw   \u001b[0m\u001b[36m \u001b[0m│ OpenClaw, personal assistant agent (setup: openclaw onboard)                       │\r\r\n│\u001b[36m \u001b[0m\u001b[36mopencode   \u001b[0m\u001b[36m \u001b[0m│ opencode, terminal coding agent                                                    │\r\r\n│\u001b[36m \u001b[0m\u001b[36mpi         \u001b[0m\u001b[36m \u001b[0m│ Pi coding agent, minimal and extensible                                            │\r\r\n│\u001b[36m \u001b[0m\u001b[36mpicoclaw   \u001b[0m\u001b[36m \u001b[0m│ PicoClaw, lightweight Go assistant (setup: picoclaw onboard)                       │\r\r\n│\u001b[36m \u001b[0m\u001b[36mpodman "]
[0.000, "o", "    \u001b[0m\u001b[36m \u001b[0m│ Podman (in a container it also needs: incus config set NAME security.nesting=true) │\r\r\n│\u001b[36m \u001b[0m\u001b[36mssh        \u001b[0m\u001b[36m \u001b[0m│ OpenSSH server; your host's public key is authorised for the dish user             │\r\r\n│\u001b[36m \u001b[0m\u001b[36muv         \u001b[0m\u001b[36m \u001b[0m│ uv, for Python versions, packages and tools                                        │\r\r\n└─────────────┴────────────────────────────────────────────────────────────────────────────────────┘\r\r\n\u001b[2mAlready in the recipe: node, uv, ssh\u001b[0m\r\r\n"]
[0.000, "o", "Extras, comma-separated, NAME@VERSION to pin (blank: none) \u001b[1;36m()\u001b[0m: "]
[2.060, "o", "claude-code\r\r\n"]
