[0.273, "o", "\u001b[3mRecipes\u001b[0m\r\r\n┏━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\r\n┃\u001b[1m \u001b[0m\u001b[1mRecipe        \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mType     \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mBase   \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mImage              \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mDescription                                  \u001b[0m\u001b[1m \u001b[0m┃\r\r\n┡━━━━━━━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\r\n│\u001b[36m \u001b[0m\u001b[36march          \u001b[0m\u001b[36m \u001b[0m│ vm        │ \u001b[2m-      \u001b[0m │\u001b[2m \u001b[0m\u001b[2mimages:archlinux   \u001b[0m\u001b[2m \u001b[0m│ Arch Linux VM                                 │\r\r\n│\u001b[36m \u001b[0m\u001b[36mdebian        \u001b[0m\u001b[36m \u001b[0m│ vm        │ \u001b[2m-      \u001b[0m │\u001b[2m \u001b[0m\u001b[2mimages:debian/13   \u001b[0m\u001b[2m \u001b[0m│ Debian 13 VM                                  │\r\r\n│\u001b[36m \u001b[0m\u001b[36mkali          \u001b[0m\u001b[36m \u001b[0m│ vm        │ \u001b[2m-      \u001b[0m │\u001b[2m \u001b[0m\u001b[2mkali-qemu          \u001b[0m\u001b[2m \u001b[0m│ Kali Linux VM (official QEMU image)           │\r\r\n│\u001b[36m \u001b[0m\u001b[36mkali-container\u001b[0m\u001b[36m \u001b[0m│ container │ \u001b[2m-      \u001b[0m │\u001b[2m \u001b[0m\u001b[2mimages:kali        \u001b[0m\u001b[2m \u001b[0m│ Kali Linux container (needs root entries in   │\r\r\n│\u001b[36m                \u001b[0m│           │         │\u001b[2m                     \u001b[0m│ /etc/subuid and /etc/subgid)                  │\r\r\n│\u001b[36m \u001b[0m\u001b[36momarchy       \u001b[0m\u001b[36m \u001b[0m│ vm        │ \u001b[2m-      \u001b[0m │\u001b[2m \u001b[0m\u001b[2momarchy-qemu       \u001b[0m\u001b[2m \u001b[0m│ Omarchy VM (official VM image)                │\r\r\n│\u001b[36m \u001b[0m\u001b[36mr"]
